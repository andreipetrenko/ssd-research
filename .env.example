# Integration Service
SDD_DATABASE_URL=postgresql+psycopg://sdd:sdd@127.0.0.1:5432/sdd
SDD_HOST=127.0.0.1
SDD_PORT=48080
SDD_PUBLIC_URL=http://127.0.0.1:48080

# Bitbucket Data Center (по умолчанию — локальный мок на 48090)
SDD_BITBUCKET_BASE_URL=http://127.0.0.1:48090
SDD_BITBUCKET_TOKEN=
SDD_BITBUCKET_WEBHOOK_SECRET=
SDD_SPEC_REPOSITORIES=SPEC/business-specs
SDD_CODE_REPOSITORIES=APP/application-repo
SDD_TARGET_BRANCHES=main,master
SDD_MIN_APPROVALS=1
SDD_REQUIRE_CI=true

# Jira Data Center (по умолчанию — тот же мок)
SDD_JIRA_BASE_URL=http://127.0.0.1:48090
SDD_JIRA_TOKEN=
SDD_JIRA_IDEA_ISSUE_TYPE=Business Idea
SDD_JIRA_IDEA_REQUIRED_FIELDS=summary,description
SDD_JIRA_ANALYSIS_PROJECT=ANL
SDD_JIRA_ANALYSIS_ISSUE_TYPE=Task
SDD_JIRA_DEV_PROJECT=DEV
SDD_JIRA_DEV_ISSUE_TYPE=Task
SDD_JIRA_DONE_TRANSITION=Done
# Дополнительные поля задач, например {"components":[{"name":"Loans"}],"customfield_10010":"CHG"}
SDD_JIRA_ANALYSIS_EXTRA_FIELDS={}
SDD_JIRA_DEV_EXTRA_FIELDS={}

# Повторы
SDD_RETRY_BASE_DELAY_SECONDS=10
SDD_MAX_ATTEMPTS=6
